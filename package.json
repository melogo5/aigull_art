{
  "name": "aigull-art",
  "version": "1.0.0",
  "description": "Full-stack application for AI-generated artwork",
  "private": true,
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "setup-hooks": "git config core.hooksPath .githooks",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm run start",
    "start:frontend": "cd frontend && npm run start",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "prettier --write \"frontend/src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:backend": "prettier --write \"backend/src/**/*.{ts,js,json,md}\"",
    "format:check": "npm run format:check:frontend && npm run format:check:backend",
    "format:check:frontend": "prettier --check \"frontend/src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check:backend": "prettier --check \"backend/src/**/*.{ts,js,json,md}\""
  },
  "keywords": [
    "react",
    "typescript",
    "express",
    "nodejs",
    "mongodb",
    "ai",
    "art",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
